подключить {
  Реактивность
  Математика
}

класс Состояние-Игры-Угадай-Число {
  #сигнал
  скрытая перем искомое-число: Целое = случайное-целое(100) + 1

  #сигнал
  скрытая перем выбранное-число: Целое = 0

  #транзакция
  функция выбрать(число: Целое) {
    выбранное-число = число
  }

  #транзакция
  функция сбросить() {
    искомое-число = случайное-целое(100) + 1
    выбранное-число = 0
  }

  функция выбранное-и-искомое-равно(число: Целое): Да-Нет? {
    вернуть условно(число != выбранное-число, пусто,
      условно(выбранное-число != искомое-число, нет, да))
  }

  функция искомое-рядом-с(число: Целое): Да-Нет {
    перем выб = выбранное-число
    перем иск = искомое-число
    вернуть знак-числа(число - выб) == знак-числа(иск - выб)
  }
}
