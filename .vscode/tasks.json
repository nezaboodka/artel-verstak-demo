{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Запустить сервер (vite)",
      "group": "build",
      "type": "shell",
      "command": "npm run запустить-сервер",
      "options": {
        "cwd": "${workspaceFolder}"
      },
    },
    {
      "label": "Собрать приложение А (артель собрать)",
      "group": "build",
      "type": "shell",
      "command": "npm run собрать-приложение-а",
      "options": {
        "cwd": "${workspaceFolder}"
      },
    },
    {
      "label": "Собрать приложение М (артель собрать)",
      "group": "build",
      "type": "shell",
      "command": "npm run собрать-приложение-м",
      "options": {
        "cwd": "${workspaceFolder}"
      },
    },
    {
      "label": "Скачать пакеты (артель скачать-пакеты)",
      "group": "build",
      "type": "shell",
      "command": "npm run скачать-пакеты",
      "options": {
        "cwd": "${workspaceFolder}"
      },
    },
    {
      "label": "Сборка активной Артель-программы",
      "type": "artel",
      "command": "build",
      "project": "${fileDirname}",
      "output": "${workspaceFolder}/сборка/${relativeFileDirname}",
      "workspace": "${workspaceFolder}",
      "standardPackages": "${workspaceFolder}/projects/СтандартныеПакеты"
    },
  ]
}
