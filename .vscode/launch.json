{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Запуск",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:1234",
      "webRoot": "${workspaceRoot}",
      "sourceMaps": true,
      "smartStep": true,
      "pauseForSourceMap": true,
      "skipFiles": [
        "<node_internals>/**",
      ],
    },
    {
      "name": "Отладка активной Артель-программы",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Сборка активной Артель-программы",
      "program": "${workspaceFolder}/сборка/${relativeFileDirname}/launch.mjs",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "pauseForSourceMap": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
  ]
}
