подключить {
  Реактивность
  JS = Platform.JavaScript
}

класс Живое-Время {
  перем интервал: Целое
  #сигнал перем час: Целое = 0
  #сигнал перем минута: Целое = 0
  #сигнал перем секунда: Целое =  0
  #сигнал перем миллисекунда: Целое = 0

  создание(интервал: Целое = 100) {
    объект.интервал = интервал
    такт()
  }

  // Скрыто

  #транзакция
  скрытая функция такт() {
    перем с = ДатаВремяМестное.сейчас()
    час = с.час
    минута = с.минута
    секунда = с.секунда
    миллисекунда = с.миллисекунда
    // Взводим таймер на сам же метод "такт"
    перем калибровка = с.миллисекунда % интервал
    JS.setTimeout(такт, интервал - калибровка)
  }
}
