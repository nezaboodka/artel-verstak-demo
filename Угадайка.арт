подключить {
  Реактивность
  Математика
}

класс Угадайка {
  #сигнал
  скрытая перем неизвестное-число: Целое = случайное-целое(100) + 1

  #сигнал
  скрытая перем пробное-число: Целое = 0

  #транзакция
  функция проба(число: Целое) {
    пробное-число = число
  }

  #транзакция
  функция сброс() {
    неизвестное-число = случайное-целое(100) + 1
    пробное-число = 0
  }

  функция это-кандидат(число: Целое): Да-Нет {
    перем п = пробное-число
    перем н = неизвестное-число
    вернуть (число < п и н < п) или
      (число > п и н > п) или
      (число == п и н == п)
  }

  функция это-угадано(число: Целое): Да-Нет? {
    вернуть условно(число != пробное-число, пусто,
      условно(пробное-число != неизвестное-число, нет, да))
  }
}
