подключить {
  Реактивность
  Верстак
}

функция Часы-Цифровые() {
  // Веб-Драйвер<Любое>.эффекта-мерцания = да

  перем время = Живое-Время(интервал = 11) // миллисекунд
  перем тема = Цветовая-Тема(время)

  Окно-Приложения({
    стиль.семейство-шрифтов = "Monospace"
    стиль.размер-шрифта = "10vh"
    стиль.тень-текста = "2pt 2pt 3pt #00000077"
    стиль.цвет-фона = тема.цвет-фона
    стиль.цвет = тема.цвет-текста
    стиль.курсор = "default"

    Блок({ текст = время.час.в-текст(2, "0") })
    Блок({ текст = ":" })
    Блок({ текст = время.минута.в-текст(2, "0") })
    Блок({ текст = ":" })
    Блок({ текст = время.секунда.в-текст(2, "0") })
    Блок({ текст = ":" })
    Блок({ текст = время.миллисекунда.в-текст(3, "0") })

    с-новой-строки()

    Блок({
      действие = {
        тема.переключить()
      }
      текст = "Тема: {условно(тема.тёмная, "Тёмная", "Светлая")}"
      стиль.прозрачность = условно(тема.авто-режим, "0.25", "")
      стиль.размер-шрифта = "5vh"
    })

    с-новой-строки()

    Блок({
      действие = {
        тема.переключить-авто-режим()
      }
      текст = "Авто-режим: {условно(тема.авто-режим, "Да", "Нет")}"
      стиль.размер-шрифта = "5vh"
    })
  })
}
