подключить {
  Верстак
}

функция Часы-Цифровые() {
  Веб-Драйвер<Любое>.эффекта-мерцания = да

  перем состояние = Живое-Время(интервал = 11) // миллисекунд

  Окно-Приложения({
    стиль.семейство-шрифтов = "Monospace"
    стиль.размер-шрифта = "10vh"

    Блок({ текст = состояние.час.в-текст(2, "0") })
    Блок({ текст = ":" })
    Блок({ текст = состояние.минута.в-текст(2, "0") })
    Блок({ текст = ":" })
    Блок({ текст = состояние.секунда.в-текст(2, "0") })
    Блок({ текст = ":" })
    Блок({ текст = состояние.миллисекунда.в-текст(3, "0") })
  })
}
