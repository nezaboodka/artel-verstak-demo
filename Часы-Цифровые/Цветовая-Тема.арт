подключить {
  Реактивность
}

класс Цветовая-Тема расширяет Р-Объект {
  // Все свойства Р-Объекта являются сигналами
  перем время: Живое-Время
  перем тёмная: Да-Нет
  перем авто-режим: Да-Нет
  перем цвет-фона: Текст
  перем цвет-текста: Текст

  создание(живое-время: Живое-Время) {
    время = живое-время
    тёмная = нет
    авто-режим = нет
    цвет-фона = ""
    цвет-текста = ""
  }

  #транзакция
  функция переключить() {
    если не(авто-режим) {
      тёмная = не(тёмная)
    }
  }

  #транзакция
  функция переключить-авто-режим() {
    авто-режим = не(авто-режим)
  }

  // Скрыто

  #реакция
  скрытая функция перенастройка() {
    если авто-режим {
      если время.час >= 22 и время.час < 6 {
        тёмная = да
        цвет-фона = "#000000"
        цвет-текста = "#FFFFFF"
      }
      иначе {
        тёмная = нет
        цвет-фона = "#E0E0E0"
        цвет-текста = "#091F27"
      }
    }
    иначе если тёмная {
      цвет-фона = "#091F27"
      цвет-текста = "#E0E0E0"
    }
    иначе {
      цвет-фона = "#FFFFFF"
      цвет-текста = "#000000"
    }
  }
}
