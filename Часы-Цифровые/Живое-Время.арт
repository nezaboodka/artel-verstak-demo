подключить {
  Реактивность
  ЯС = Платформа.ДжаваСкрипт
}

класс Живое-Время {
  перем интервал: Целое
  #сигнал перем год: Целое = 0
  #сигнал перем месяц: Целое = 0
  #сигнал перем день: Целое = 0
  #сигнал перем час: Целое = 0
  #сигнал перем минута: Целое = 0
  #сигнал перем секунда: Целое =  0
  #сигнал перем миллисекунда: Целое = 0

  создание(интервал: Целое = 100) {
    объект.интервал = интервал
    такт()
  }

  // Скрыто

  #транзакция
  скрытая функция такт() {
    перем с = Дата-Время-Местное.сейчас()
    год = с.год
    месяц = с.месяц
    день = с.день
    час = с.час
    минута = с.минута
    секунда = с.секунда
    миллисекунда = с.миллисекунда
    // Взводим таймер на сам же метод "такт"
    перем калибровка = с.миллисекунда % интервал
    ЯС.взвести-таймер(такт, интервал - калибровка)
  }
}
