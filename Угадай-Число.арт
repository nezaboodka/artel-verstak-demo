подключить {
  Верстак
}

функция Игра-Угадай-Число(состояние: Состояние-Игры-Угадай-Число) {

  Блок({
    стиль.размер-шрифта = "150%"
    текст = "Угадай число от 1 до 100"
  })

  с-новой-строки()

  Блок({
    стиль.зазор-сверху = "2em"
    стиль.зазор-снизу = "2em"
    для а из интервал(0, 9) {
      с-новой-строки()
      для б из интервал(1, 10) {
        Кнопка(а * 10 + б, состояние)
      }
    }
  })

  с-новой-строки()

  Блок({
    стиль.поле = "0.25em 0.5em"
    стиль.радиус-границы = "0.35em"
    стиль.цвет-фона = "#FFF1"
    текст = "Сброс"
    начинка.onclick = функция(объект, ev): Объект? {
      состояние.сбросить()
      возврат пусто
    }
  })
}

функция Кнопка(число: Целое, состояние: Состояние-Игры-Угадай-Число) {
  Блок({
    текст = "{число}"
    стиль.зазор = "0.2em"
    стиль.радиус-границы = "0.35em"
    стиль.минимальная-высота = "1.5em"
    стиль.минимальная-ширина = "2em"

    выбор состояние.совпадает-с-выбором-и-искомым(число)
      либо да {
        стиль.цвет-фона = "#070"
      }
      либо нет {
        стиль.цвет-фона = "#700"
      }
      либо пусто {
        стиль.цвет-фона = "#FFF1"
      }

    если состояние.рядом-с-искомым(число) {
      стиль.цвет = "#FFF"
    }
    иначе {
      стиль.цвет = "#FFF2"
    }

    начинка.onclick = функция(объект, ev): Объект? {
      состояние.выбрать(число)
      возврат пусто
    }
  })
}
