подключить {
  Верстак
}

функция Угадай-Число() {

  перем игра = Угадайка()

  Блок({
    стиль.размер-шрифта = "150%"
    текст = "Угадай число от 1 до 100"
  })

  с-новой-строки()

  Блок({
    стиль.зазор-сверху = "2em"
    стиль.зазор-снизу = "2em"
    для а из интервал(0, 9) {
      с-новой-строки()
      для б из интервал(1, 10) {
        Кнопка(а * 10 + б, игра)
      }
    }
  })

  с-новой-строки()

  Блок({
    стиль.поле = "0.25em 0.5em"
    стиль.радиус-границы = "0.35em"
    стиль.цвет-фона = "#FFF1"
    текст = "Сброс"
    начинка.onclick = функция(объект, ev): Объект? {
      игра.сброс()
      возврат пусто
    }
  })
}

функция Кнопка(число: Целое, игра: Угадайка) {
  Блок({
    текст = "{число}"
    стиль.зазор = "0.2em"
    стиль.радиус-границы = "0.35em"
    стиль.минимальная-высота = "1.5em"
    стиль.минимальная-ширина = "2em"

    если игра.это-кандидат(число) {
      стиль.цвет = "#FFF"
    }
    иначе {
      стиль.цвет = "#FFF2"
    }

    выбор игра.это-угадано(число)
    либо да {
      стиль.цвет-фона = "#070"
    }
    либо нет {
      стиль.цвет-фона = "#700"
    }
    либо пусто {
      стиль.цвет-фона = "#FFF1"
    }

    начинка.onclick = функция(объект, ev): Объект? {
      игра.проба(число)
      возврат пусто
    }
  })
}
