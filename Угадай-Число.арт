подключить {
  Реактивность
  Верстак
  Математика
}

класс Игра {
  #сигнал перем неизвестное-число: Целое = случайное-целое(100) + 1
  #сигнал перем пробное-число: Целое = 0
}

функция Угадай-Число() {

  перем игра = Игра()

  Блок({
    стиль.размер-шрифта = "150%"
    текст = "Угадай число от 1 до 100"
  })

  с-новой-строки()

  Блок({
    стиль.зазор-сверху = "2em"
    стиль.зазор-снизу = "2em"
    для а из интервал(0, 9) {
      с-новой-строки()
      для б из интервал(1, 10) {
        Кнопка(а * 10 + б, игра)
      }
    }
  })

  с-новой-строки()

  Блок({
    стиль.поле = "0.25em 0.5em"
    стиль.радиус-границы = "0.35em"
    стиль.цвет-фона = "#FFF1"
    текст = "Сброс"
    начинка.onclick = функция(объект, ev): Объект? {
      выполнить-транзакционно({
        игра.пробное-число = 0
      }, [])
      возврат пусто
    }
  })
}

функция Кнопка(число: Целое, игра: Игра) {
  Блок({
    текст = "{число}"
    стиль.зазор = "0.2em"
    стиль.радиус-границы = "0.35em"
    стиль.минимальная-высота = "1.5em"
    стиль.минимальная-ширина = "2em"
    перем проб = игра.пробное-число
    перем неизв = игра.неизвестное-число
    стиль.цвет =
      условно(
        (число < проб и неизв < проб) или
        (число > проб и неизв > проб) или
        (число == проб и неизв == проб), "#FFF", "#FFF2")
    стиль.цвет-фона =
      условно(число != проб, "#FFF1",
      условно(неизв != проб, "#700", "#070"))
    начинка.onclick = функция(объект, ev): Объект? {
      выполнить-транзакционно({
        игра.пробное-число = число
      }, [])
      возврат пусто
    }
  })
}
