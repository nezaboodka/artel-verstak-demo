подключить {
  Реактивность
  Верстак
  Математика
}

класс Игра {
  #сигнал перем случайное-число: Целое = случайное-целое(100) + 1
  #сигнал перем пробное-число: Целое = 0
}

функция Угадай-Число() {
  перем игра = Игра()

  Блок({
    // самовыравнивание-вертикально = В.растяжение
    стиль.размер-шрифта = "150%"
    текст = "Угадай число от 1 до 100"
  })

  с-новой-строки()

  Блок({
    стиль.размер-шрифта = "150%"
    стиль.зазор-сверху = "1em"
    стиль.зазор-снизу = "1em"
    если игра.случайное-число != игра.пробное-число {
      перем меньше = игра.случайное-число < игра.пробное-число
      перем знак = условно(меньше, "<", ">")
      текст = "? {знак} {игра.пробное-число}"
    }
    иначе {
      текст = "Да, это число {игра.случайное-число}!"
    }
  })

  с-новой-строки()

  Блок({
    для а из интервал(0, 9) {
      с-новой-строки()
      для б из интервал(1, 10) {
        Кнопка(а * 10 + б, игра)
      }
    }
  })
}

функция Кнопка(число: Целое, игра: Игра) {
  Блок({
    текст = "{число}"
    стиль.зазор = "0.2em"
    стиль.радиус-границы = "0.2em"
    стиль.минимальная-высота = "1.5em"
    стиль.минимальная-ширина = "2em"
    перем п = игра.пробное-число
    перем с = игра.случайное-число
    стиль.цвет = условно(
      (число < п и с < п) или
      (число > п и с > п) или
      (число == п и с == п),
      "#FFF", "#FFF2")
    стиль.цвет-фона =
      условно(п != число, "#FFF1",
      условно(п != игра.случайное-число, "#700",
      "#070"))
    начинка.onclick = функция(объект, ev): Объект? {
      выполнить-транзакционно({
        игра.пробное-число = число
      }, [])
      возврат пусто
    }
  })
}
