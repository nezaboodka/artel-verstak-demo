подключить {
  Реактивность
  Верстак
  Математика
}

класс Игра {
  #сигнал перем случайное-число: Целое = случайное-целое(100) + 1
  #сигнал перем пробное-число: Целое = 0
}

функция Угадай-Число() {

  перем игра = Игра()

  Блок({
    стиль.размер-шрифта = "150%"
    текст = "Угадай число от 1 до 100"
  })

  с-новой-строки()

  Блок({
    стиль.размер-шрифта = "150%"
    стиль.зазор-сверху = "1em"
    стиль.зазор-снизу = "1em"
    перем случ = игра.случайное-число
    перем проб = игра.пробное-число
    если случ != проб {
      перем меньше = случ < проб
      перем знак = условно(меньше, "<", ">")
      текст = "? {знак} {проб}"
    }
    иначе {
      текст = "Да, это число {игра.случайное-число}!"
    }
  })

  с-новой-строки()

  Блок({
    для а из интервал(0, 9) {
      с-новой-строки()
      для б из интервал(1, 10) {
        Кнопка(а * 10 + б, игра)
      }
    }
  })
}

функция Кнопка(число: Целое, игра: Игра) {
  Блок({
    текст = "{число}"
    стиль.зазор = "0.2em"
    стиль.радиус-границы = "0.2em"
    стиль.минимальная-высота = "1.5em"
    стиль.минимальная-ширина = "2em"
    перем проб = игра.пробное-число
    перем случ = игра.случайное-число
    стиль.цвет =
      условно(
        (число < проб и случ < проб) или
        (число > проб и случ > проб) или
        (число == проб и случ == проб), "#FFF", "#FFF2")
    стиль.цвет-фона =
      условно(проб != число, "#FFF1",
      условно(проб != случ, "#700", "#070"))
    начинка.onclick = функция(объект, ev): Объект? {
      выполнить-транзакционно({
        игра.пробное-число = число
      }, [])
      возврат пусто
    }
  })
}
