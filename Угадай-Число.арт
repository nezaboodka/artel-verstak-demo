подключить {
  Реактивность
  Верстак
  Математика
}

класс Угадайка {
  #сигнал скрытая перем неизвестное-число: Целое = случайное-целое(100) + 1
  #сигнал скрытая перем пробное-число: Целое = 0

  #транзакция
  функция проба(число: Целое) {
    пробное-число = число
  }

  #транзакция
  функция сброс() {
    неизвестное-число = случайное-целое(100) + 1
    пробное-число = 0
  }

  функция кандидат(число: Целое): Да-Нет {
    перем п = пробное-число
    перем н = неизвестное-число
    вернуть (число < п и н < п) или
      (число > п и н > п) или
      (число == п и н == п)
  }

  функция угадано(число: Целое): Да-Нет? {
    вернуть условно(число != пробное-число, пусто,
      условно(пробное-число != неизвестное-число, нет, да))
  }
}

функция Угадай-Число() {

  перем игра = Угадайка()

  Блок({
    стиль.размер-шрифта = "150%"
    текст = "Угадай число от 1 до 100"
  })

  с-новой-строки()

  Блок({
    стиль.зазор-сверху = "2em"
    стиль.зазор-снизу = "2em"
    для а из интервал(0, 9) {
      с-новой-строки()
      для б из интервал(1, 10) {
        Кнопка(а * 10 + б, игра)
      }
    }
  })

  с-новой-строки()

  Блок({
    стиль.поле = "0.25em 0.5em"
    стиль.радиус-границы = "0.35em"
    стиль.цвет-фона = "#FFF1"
    текст = "Сброс"
    начинка.onclick = функция(объект, ev): Объект? {
      игра.сброс()
      возврат пусто
    }
  })
}

функция Кнопка(число: Целое, игра: Угадайка) {
  Блок({
    текст = "{число}"
    стиль.зазор = "0.2em"
    стиль.радиус-границы = "0.35em"
    стиль.минимальная-высота = "1.5em"
    стиль.минимальная-ширина = "2em"
    стиль.цвет = условно(игра.кандидат(число), "#FFF", "#FFF2")
    выбор игра.угадано(число)
    либо да { стиль.цвет-фона = "#070" }
    либо нет { стиль.цвет-фона = "#700" }
    либо пусто { стиль.цвет-фона = "#FFF1" }
    начинка.onclick = функция(объект, ev): Объект? {
      игра.проба(число)
      возврат пусто
    }
  })
}
