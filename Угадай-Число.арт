подключить {
  Реактивность
  Верстак
  Математика
}

класс Игра {
  #сигнал перем искомое: Целое = случайное-целое(100) + 1
  #сигнал перем проба: Целое = 0
  #сигнал перем больше: Целое = 0
  #сигнал перем меньше: Целое = 101
}

функция Угадай-Число() {
  перем игра = Игра()

  Блок({
    // самовыравнивание-вертикально = В.растяжение
    стиль.размер-шрифта = "150%"
    текст = "Угадай число от 1 до 100"
  })

  с-новой-строки()

  Блок({
    стиль.размер-шрифта = "150%"
    стиль.зазор-сверху = "1em"
    стиль.зазор-снизу = "1em"
    если игра.искомое != игра.проба {
      перем знак = условно(игра.искомое < игра.проба, "<", ">")
      текст = "?   {знак}   {игра.проба}"
    }
    иначе {
      текст = "Да, это число {игра.искомое}!"
    }
  })

  с-новой-строки()

  Блок({
    для а из интервал(0, 9) {
      с-новой-строки()
      для б из интервал(1, 10) {
        Кнопка(а * 10 + б, игра)
      }
    }
  })
}

функция Кнопка(число: Целое, игра: Игра) {
  Блок({
    текст = "{число}"
    стиль.зазор = "0.2em"
    стиль.радиус-границы = "0.2em"
    стиль.минимальная-высота = "1.5em"
    стиль.минимальная-ширина = "2em"
    стиль.цвет =
      условно(число < игра.проба и игра.искомое < игра.проба, "#FFF",
      условно(число > игра.проба и игра.искомое > игра.проба, "#FFF",
      условно(число == игра.проба и игра.искомое == игра.проба, "#FFF",
      "#FFF2")))
    стиль.цвет-фона =
      условно(игра.проба != число, "#FFF1",
      условно(игра.проба != игра.искомое, "#700",
      "#070"))
    начинка.onclick = функция(объект, ev): Объект? {
      выполнить-транзакционно({
        игра.проба = число
      }, [])
      возврат пусто
    }
  })
}
