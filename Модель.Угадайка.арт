подключить {
  Реактивность
  Математика
}

класс Угадайка {
  #сигнал
  скрытая перем искомое-число: Целое = случайное-целое(100) + 1

  #сигнал
  скрытая перем пробное-число: Целое = 0

  #транзакция
  функция проба(число: Целое) {
    пробное-число = число
  }

  #транзакция
  функция сброс() {
    искомое-число = случайное-целое(100) + 1
    пробное-число = 0
  }

  функция близко-к-искомому(число: Целое): Да-Нет {
    перем пр = пробное-число
    перем иск = искомое-число
    вернуть знак-числа(число - пр) == знак-числа(иск - пр)
  }

  функция угадано(число: Целое): Да-Нет? {
    вернуть условно(число != пробное-число, пусто,
      условно(пробное-число != искомое-число, нет, да))
  }
}
