функция Часы-Цифровые()
{
  // Веб-Драйвер<Пусто>.эффекта-мерцания = да

  пусть время = Живое-Время(интервал = 11) // миллисекунд

  ОкноПриложения(
  {
    стиль.цвет = "#f0f0f0"
    стиль.цвет-фона = "#091F27"
    стиль.размер-шрифта = "10vh"
    стиль.семейство-шрифтов = "Monospace"
    стиль.курсор = "default"

    Блок({ текст = время.час.в-текст(2, "0") })
    Блок({ текст = ":" })
    Блок({ текст = время.минута.в-текст(2, "0") })
    Блок({ текст = ":" })
    Блок({ текст = время.секунда.в-текст(2, "0") })
    Блок({ текст = ":" })
    Блок({ текст = время.миллисекунда.в-текст(3, "0") })
  })
}
