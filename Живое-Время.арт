класс Живое-Время
{
  перем интервал: Целое

  #сигнал
  перем час: Целое = 0

  #сигнал
  перем минута: Целое = 0

  #сигнал
  перем секунда: Целое =  0

  #сигнал
  перем миллисекунда: Целое = 0

  создание(интервал: Целое = 100)
  {
    объект.интервал = интервал
    такт()
  }

  // Скрыто

  #транзакция
  скрыто
  функция такт()
  {
    перем время = ДатаВремяМестное.сейчас()
    перем калибровка = время.миллисекунда % интервал
    час = время.час
    минута = время.минута
    секунда = время.секунда
    миллисекунда = время.миллисекунда
    setTimeout(такт, интервал - калибровка)
  }
}
