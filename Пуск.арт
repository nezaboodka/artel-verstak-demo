
подключить Платформа.Браузер
подключить Реактивность
подключить Верстак

выполнить
{
  пусть часики = транзакция<Часы>({ Часы(100) }, [])

  Окно(
  {
    пусть с = эл.стиль
    с.цвет = "#f0f0f0"
    с.цвет-фона = "#1a3043"
    с.размер-шрифта = "200%"

    Панель(
    {
      эл.по-горизонтали = Горизонтально.растяжение
      эл.по-вертикали = Вертикально.растяжение
      эл.содержимое-по-горизонтали = Горизонтально.по-центру
      эл.содержимое-по-вертикали = Вертикально.по-центру

      Панель(
      {
        пусть с = эл.стиль
        с.поле = "1em"
        с.радиус-границы = "0.5em"
        с.цвет-фона = "rgba(127, 127, 127, 0.5)"
        // эл.содержимое-по-горизонтали = Горизонтально.по-центру

        Панель(
          режим = Режим.автономный,
          наполнение =
          {
            Надпись("Угадай число")

            с-новой-строки()

            Надпись("{часики.час}:{часики.минута}:{часики.секунда}")
          })

        с-новой-строки()

        Таблица(
        {
          эл.стиль.зазор-сверху = "1em"
          эл.по-горизонтали = Горизонтально.растяжение
          эл.содержимое-по-горизонтали = Горизонтально.по-центру

          Кнопка("1")
          Кнопка("2")
          Кнопка("3")

          с-новой-строки()
          Кнопка("4")
          Кнопка("5")
          Кнопка("6")

          с-новой-строки()
          Кнопка("7")
          Кнопка("8")
          Кнопка("9")

          с-новой-строки()
          Кнопка("")
          Кнопка("0")
          Кнопка("")
        })
      })
    })
  })
}

операция Кнопка(надпись: Текст)
{
  Панель(
  {
    эл.стиль.зазор = "0.25em"
    эл.стиль.поле = "0.25em"
    эл.стиль.тень-области = "0 0 0.1em 0 black"
    эл.стиль.радиус-границы = "0.1em"
    Надпись(надпись)
  })
}
