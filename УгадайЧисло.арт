
// подключить Артель
// подключить Браузер
подключить Реактивность
подключить Верстак

выполнить
{
  // РеактивнаяСистема.установить-режим-журнализации(да, ~LoggingLevel.Debug)

  запустить(Окно(
    режим = Режим.автономный,
    тело =
    {
      пусть часы = Часы-Реального-Времени(100)

      стиль.цвет = "#f0f0f0"
      стиль.цвет-фона = "#1a3043"
      стиль.размер-шрифта = "200%"

      Блок(
      {
        по-горизонтали = Горизонтально.растяжение
        по-вертикали = Вертикально.растяжение
        содержимое-по-горизонтали = Горизонтально.по-центру
        содержимое-по-вертикали = Вертикально.по-центру

        Блок(
        {
          стиль.поле = "1em"
          стиль.радиус-границы = "0.5em"
          стиль.цвет-фона = "rgba(0, 0, 0, 0.5)"
          // содержимое-по-горизонтали = Горизонтально.по-центру

          Блок(
            режим = Режим.автономный,
            тело =
            {
              Блок({ текст = "Угадай число" })

              с-новой-строки()

              пусть ч = часы.час.в-текст(2, "0")
              пусть м = часы.минута.в-текст(2, "0")
              пусть с = часы.секунда.в-текст(2, "0")
              Блок({ текст = "{ч}:{м}:{с}" })
            })

          с-новой-строки()

          Таблица(
          {
            стиль.зазор-сверху = "1em"
            по-горизонтали = Горизонтально.растяжение
            содержимое-по-горизонтали = Горизонтально.по-центру

            Кнопка("1")
            Кнопка("2")
            Кнопка("3")

            с-новой-строки()

            Кнопка("4")
            Кнопка("5")
            Кнопка("6")

            с-новой-строки()

            Кнопка("7")
            Кнопка("8")
            Кнопка("9")

            с-новой-строки()

            Кнопка("")
            Кнопка("0")
            Кнопка("")
          })
        })
      })
  }))
}

функция Кнопка(надпись: Текст)
{
  Блок(
  {
    стиль.зазор = "0.25em"
    стиль.поле = "0.25em"
    стиль.цвет-границы = "rgba(255, 255, 255, 0.75)"
    стиль.толщина-границы = "1pt"
    стиль.стиль-границы = "solid"
    стиль.радиус-границы = "0.2em"

    Блок({ текст = надпись })
  })
}
