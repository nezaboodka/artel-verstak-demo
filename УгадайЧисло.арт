
подключить Браузер
подключить Реактивность
подключить Верстак

выполнить
{
  пусть часики = транзакция<Часы>({ Часы(100) }, [])

  Окно(
  {
    эл.стиль.цвет = "#f0f0f0"
    эл.стиль.цвет-фона = "#1a3043"
    эл.стиль.размер-шрифта = "200%"

    Панель(
    {
      эл.по-горизонтали = Горизонтально.растяжение
      эл.по-вертикали = Вертикально.растяжение
      эл.содержимое-по-горизонтали = Горизонтально.по-центру
      эл.содержимое-по-вертикали = Вертикально.по-центру

      Панель(
      {
        эл.стиль.поле = "1em"
        эл.стиль.радиус-границы = "0.5em"
        эл.стиль.цвет-фона = "rgba(0, 0, 0, 0.5)"
        // эл.содержимое-по-горизонтали = Горизонтально.по-центру

        Панель(
          режим = Режим.автономный,
          скрипт =
          {
            Надпись("Угадай число")

            с-новой-строки()

            Надпись("{часики.час}:{часики.минута}:{часики.секунда}")
          })

        с-новой-строки()

        Таблица(
        {
          эл.стиль.зазор-сверху = "1em"
          эл.по-горизонтали = Горизонтально.растяжение
          эл.содержимое-по-горизонтали = Горизонтально.по-центру

          Кнопка("1")
          Кнопка("2")
          Кнопка("3")

          с-новой-строки()

          Кнопка("4")
          Кнопка("5")
          Кнопка("6")

          с-новой-строки()

          Кнопка("7")
          Кнопка("8")
          Кнопка("9")

          с-новой-строки()

          Кнопка("")
          Кнопка("0")
          Кнопка("")
        })
      })
    })
  })
}

функция Кнопка(надпись: Текст)
{
  Панель(
  {
    эл.стиль.зазор = "0.25em"
    эл.стиль.поле = "0.25em"
    эл.стиль.цвет-границы = "rgba(255, 255, 255, 0.75)"
    эл.стиль.толщина-границы = "1pt"
    эл.стиль.стиль-границы = "solid"
    эл.стиль.радиус-границы = "0.2em"

    Надпись(надпись)
  })
}
