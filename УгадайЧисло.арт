
// подключить Артель
// подключить Браузер
подключить Реактивность
подключить Верстак
подключить Математика

класс Игра расширяет Р-Объект {
  перем загадка: Целое
  перем ответ: Целое
}

выполнить {
  запустить({
    пусть часы = Живые-Часы(100)
    пусть игра = Игра(загадка = случайное-целое(100), ответ = 99)

    ОкноПриложения({
      стиль.цвет = "#f0f0f0"
      стиль.цвет-фона = "#091F27"
      стиль.размер-шрифта = "3vh"
      стиль.курсор = "default"

      Блок({
        самовыравнивание-вертикально = В.растяжение
        стиль.размер-шрифта = "150%"
        текст = "Угадай число"
      })

      с-новой-строки()

      Блок({
        стиль.размер-шрифта = "150%"
        стиль.зазор-снизу = "2em"

        Блок({
          стиль.минимальная-ширина = "2em"
          текст = "?"
        })

        Блок({
          стиль.зазор = "0 1em"
          текст = "<"
        })

        Блок({
          стиль.минимальная-ширина = "2em"
          текст = "{игра.ответ}"
        })
      })

      с-новой-строки()

      Блок({
        для а из интервал(0, 9) {
          с-новой-строки()
          для б из интервал(0, 9) {
            Кнопка("{а * 10 + б}")
          }
        }
      })

      с-новой-строки()

      Блок({
        самовыравнивание-вертикально = В.растяжение
        пусть ч = часы.час.в-текст(2, "0")
        пусть м = часы.минута.в-текст(2, "0")
        пусть с = часы.секунда.в-текст(2, "0")
        текст = "{ч}:{м}:{с}"
      })
    })
  }, [])
}

функция Кнопка(надпись: Текст) {
  Блок({
    стиль.зазор = "0.2em"
    стиль.поле = "0.1em 0.2em"
    // стиль.цвет-границы = "rgba(255, 255, 255, 0.75)"
    // стиль.толщина-границы = "1pt"
    // стиль.стиль-границы = "solid"
    стиль.цвет-фона = "#FFF1"
    стиль.радиус-границы = "0.2em"
    стиль.минимальная-ширина = "1.5em"
    текст = надпись
  })
}
