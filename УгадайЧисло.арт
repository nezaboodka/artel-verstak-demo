
// подключить Артель
// подключить Браузер
подключить Реактивность
подключить Верстак
подключить Математика

класс Игра {
  #сигнал
  перем загадка: Целое = случайное-целое(100)

  #сигнал
  перем ответ: Целое = 100
}

выполнить {
  // Реактивная-Система.установить-режим-журнализации(да, Уровень-Журнализации.Debug)

  запустить({
    пусть игра = Игра()

    ОкноПриложения({
      стиль.цвет = "#f0f0f0"
      стиль.цвет-фона = "#091F27"
      стиль.размер-шрифта = "3vh"
      стиль.курсор = "default"

      Блок({
        // самовыравнивание-вертикально = В.растяжение
        стиль.размер-шрифта = "150%"
        текст = "Угадай число"
      })

      с-новой-строки()

      Блок({
        стиль.размер-шрифта = "150%"
        стиль.зазор-сверху = "1em"
        стиль.зазор-снизу = "1em"

        если игра.загадка != игра.ответ {
          Блок({
            стиль.минимальная-ширина = "2em"
            текст = "?"
          })

          Блок({
            стиль.зазор = "0 1em"
            если игра.загадка < игра.ответ {
              текст = "<"
            }
            иначе {
              текст = ">"
            }
          })

          Блок({
            стиль.минимальная-ширина = "2em"
            текст = "{игра.ответ}"
          })
        }
        иначе {
          Блок(ключ = "Ура!", тело = {
            стиль.минимальная-ширина = "2em"
            текст = "Угадали, это {игра.загадка}!"
          })
        }
      })

      с-новой-строки()

      Блок({
        для а из интервал(0, 9) {
          с-новой-строки()
          для б из интервал(0, 9) {
            Кнопка("{а * 10 + б}", игра)
          }
        }
      })
    })
  }, [])
}

функция Кнопка(надпись: Текст, игра: Игра) {
  Блок({
    пусть б = объект
    текст = надпись
    стиль.зазор = "0.2em"
    // стиль.поле = "0.1em 0.2em"
    стиль.цвет-фона = "#FFF1"
    стиль.радиус-границы = "0.2em"
    стиль.минимальная-высота = "1.5em"
    стиль.минимальная-ширина = "2em"
    начинка.onclick = функция(объект, ev): Объект? {
      выполнить-транзакционно({
        игра.ответ = Целое(надпись)
      }, [])
      возврат пусто
    }
  })
}
