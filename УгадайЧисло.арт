
подключить Артель
подключить Браузер
подключить Реактивность
подключить Верстак

выполнить
{
  // РеактивнаяСистема.установить-режим-журнализации(да, ~LoggingLevel.Debug)

  запустить(Окно(
    режим = Режим.автономный,
    тело =
    {
      пусть часы = Часы-Реального-Времени(100)
      пусть оо = 'объект'

      оо.стиль.цвет = "#f0f0f0"
      оо.стиль.цвет-фона = "#1a3043"
      оо.стиль.размер-шрифта = "200%"

      Блок(
      {
        пусть оо = 'объект'
        оо.по-горизонтали = Горизонтально.растяжение
        оо.по-вертикали = Вертикально.растяжение
        оо.содержимое-по-горизонтали = Горизонтально.по-центру
        оо.содержимое-по-вертикали = Вертикально.по-центру

        Блок(
        {
          пусть оо = 'объект'
          оо.стиль.поле = "1em"
          оо.стиль.радиус-границы = "0.5em"
          оо.стиль.цвет-фона = "rgba(0, 0, 0, 0.5)"
          // о.содержимое-по-горизонтали = Горизонтально.по-центру

          Блок(
            режим = Режим.автономный,
            тело =
            {
              Блок({ 'объект'.текст = "Угадай число" })

              с-новой-строки()

              пусть ч = часы.час.в-текст(2, "0")
              пусть м = часы.минута.в-текст(2, "0")
              пусть с = часы.секунда.в-текст(2, "0")
              Блок({ 'объект'.текст = "{ч}:{м}:{с}" })
            })

          с-новой-строки()

          Таблица(
          {
            пусть оо = 'объект'
            оо.стиль.зазор-сверху = "1em"
            оо.по-горизонтали = Горизонтально.растяжение
            оо.содержимое-по-горизонтали = Горизонтально.по-центру

            Кнопка("1")
            Кнопка("2")
            Кнопка("3")

            с-новой-строки()

            Кнопка("4")
            Кнопка("5")
            Кнопка("6")

            с-новой-строки()

            Кнопка("7")
            Кнопка("8")
            Кнопка("9")

            с-новой-строки()

            Кнопка("")
            Кнопка("0")
            Кнопка("")
          })
        })
      })
  }))
}

функция Кнопка(надпись: Текст)
{
  Блок(
  {
    пусть оо = 'объект'
    оо.стиль.зазор = "0.25em"
    оо.стиль.поле = "0.25em"
    оо.стиль.цвет-границы = "rgba(255, 255, 255, 0.75)"
    оо.стиль.толщина-границы = "1pt"
    оо.стиль.стиль-границы = "solid"
    оо.стиль.радиус-границы = "0.2em"

    Блок({ 'объект'.текст = надпись })
  })
}
