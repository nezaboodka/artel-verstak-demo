// подключить Браузер
подключить Реактивность
подключить Верстак
подключить Математика

класс Игра расширяет Р-Объект {
  перем загадка: Целое
  перем ответ: Целое
}

выполнить {
  запустить({
    пусть часы = Живые-Часы(100)
    пусть игра = Игра(загадка = случайное-целое(100), ответ = 99)
    ОкноПриложения({
      стиль.цвет = "#f0f0f0"
      стиль.цвет-фона = "#091F27"
      стиль.размер-шрифта = "200%"

      Блок({
        самовыравнивание-вертикально = В.растяжение
        стиль.размер-шрифта = "150%"
        текст = "Угадай число"
      })

      с-новой-строки()

      Блок({

        Блок({
          текст = "?"
        })

        Блок({
          стиль.зазор = "0 0.5em"
          текст = "<"
        })

        Блок({
          текст = "{игра.ответ}"
        })

        с-новой-строки()

        Блок({
          стиль.поле = "1em"
          стиль.радиус-границы = "0.5em"
          стиль.цвет-фона = "#0007"
          стиль.зазор-сверху = "1em"
          самовыравнивание-горизонтально = Г.растяжение

          с-новой-строки()

          Кнопка("1")
          Кнопка("2")
          Кнопка("3")

          с-новой-строки()

          Кнопка("4")
          Кнопка("5")
          Кнопка("6")

          с-новой-строки()

          Кнопка("7")
          Кнопка("8")
          Кнопка("9")

          с-новой-строки()

          Кнопка("0")
        })
      })

      с-новой-строки()

      Блок({
        самовыравнивание-вертикально = В.растяжение
        пусть ч = часы.час.в-текст(2, "0")
        пусть м = часы.минута.в-текст(2, "0")
        пусть с = часы.секунда.в-текст(2, "0")
        текст = "{ч}:{м}:{с}"
      })
    })
  }, [])
}

функция Поле(надпись: Текст) {
  Блок({
    стиль.зазор = "0.25em"
    стиль.поле = "0.25em"
    стиль.цвет-границы = "#0000"
    стиль.толщина-границы = "1pt"
    стиль.стиль-границы = "solid"
    стиль.радиус-границы = "0.2em"
    стиль.минимальная-ширина = "1.5em"
    стиль.цвет-фона = "#80808080"
    текст = надпись
  })
}

функция Кнопка(надпись: Текст) {
  Блок({
    стиль.зазор = "0.25em"
    стиль.поле = "0.25em"
    стиль.цвет-границы = "rgba(255, 255, 255, 0.75)"
    стиль.толщина-границы = "1pt"
    стиль.стиль-границы = "solid"
    стиль.радиус-границы = "0.2em"
    стиль.минимальная-ширина = "1.5em"
    текст = надпись
  })
}
