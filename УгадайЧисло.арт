
подключить Артель
подключить Браузер
подключить Реактивность
подключить Верстак

выполнить
{
  // РеактивнаяСистема.установить-режим-журнализации(да, ~LoggingLevel.Debug)

  Окно(
    режим = Режим.автономный,
    тело =
    {
      пусть часы = Часы-Реального-Времени(100)

      o.стиль.цвет = "#f0f0f0"
      o.стиль.цвет-фона = "#1a3043"
      o.стиль.размер-шрифта = "200%"

      Блок(
      {
        o.по-горизонтали = Горизонтально.растяжение
        o.по-вертикали = Вертикально.растяжение
        o.содержимое-по-горизонтали = Горизонтально.по-центру
        o.содержимое-по-вертикали = Вертикально.по-центру

        Блок(
        {
          o.стиль.поле = "1em"
          o.стиль.радиус-границы = "0.5em"
          o.стиль.цвет-фона = "rgba(0, 0, 0, 0.5)"
          // o.содержимое-по-горизонтали = Горизонтально.по-центру

          Блок(
            режим = Режим.автономный,
            тело =
            {
              Блок({ o.текст = "Угадай число" })

              с-новой-строки()

              пусть ч = часы.час.в-текст(2, "0")
              пусть м = часы.минута.в-текст(2, "0")
              пусть с = часы.секунда.в-текст(2, "0")
              Блок({ o.текст = "{ч}:{м}:{с}" })
            })

          с-новой-строки()

          Таблица(
          {
            o.стиль.зазор-сверху = "1em"
            o.по-горизонтали = Горизонтально.растяжение
            o.содержимое-по-горизонтали = Горизонтально.по-центру

            Кнопка("1")
            Кнопка("2")
            Кнопка("3")

            с-новой-строки()

            Кнопка("4")
            Кнопка("5")
            Кнопка("6")

            с-новой-строки()

            Кнопка("7")
            Кнопка("8")
            Кнопка("9")

            с-новой-строки()

            Кнопка("")
            Кнопка("0")
            Кнопка("")
          })
        })
      })
  })
}

функция Кнопка(надпись: Текст)
{
  Блок(
  {
    o.стиль.зазор = "0.25em"
    o.стиль.поле = "0.25em"
    o.стиль.цвет-границы = "rgba(255, 255, 255, 0.75)"
    o.стиль.толщина-границы = "1pt"
    o.стиль.стиль-границы = "solid"
    o.стиль.радиус-границы = "0.2em"

    Блок({ o.текст = надпись })
  })
}
