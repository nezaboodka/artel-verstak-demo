операция Игра-Угадай-Число()
  // Веб-Драйвер<Любое>.эффекта-мерцания = да

  перем состояние = Состояние-Игры-Угадай-Число()

  Окно-Приложения({
    стиль.цвет = "#f0f0f0"
    стиль.цвет-фона = "#091F27"
    стиль.семейство-шрифтов = "sans-serif"
    стиль.размер-шрифта = "3vh"
    стиль.тень-текста = "2pt 2pt 2pt black"
    стиль.курсор = "default"

    Блок({
      текст = "Угадай число от 1 до 100"
      стиль.размер-шрифта = "150%"
    })

    с-новой-строки()

    Блок({
      стиль.зазор-сверху = "2em"
      стиль.зазор-снизу = "2em"
      для а из интервал(0, 9)
        с-новой-строки()
        для б из интервал(1, 10)
          Кнопка-Числовая(а * 10 + б, состояние)
        кнц
      кнц
    })

    с-новой-строки()

    Блок({
      текст = "Сброс"
      действие = {
        состояние.сбросить()
      }
      стиль.поле = "0.25em 0.5em"
      стиль.радиус-границы = "0.35em"
      стиль.цвет-фона = "#FFF1"
      стиль.тень-области = "1pt 1pt 2pt black"
    })
  })
кнц

операция Кнопка-Числовая(число: Целое, состояние: Состояние-Игры-Угадай-Число)
  Блок({
    текст = "{число}"
    действие = {
      состояние.выбрать(число)
    }
    стиль.зазор = "0.2em"
    стиль.радиус-границы = "0.35em"
    стиль.минимальная-высота = "1.5em"
    стиль.минимальная-ширина = "2em"
    стиль.тень-области = "1pt 1pt 2pt black"
    стиль.переход = "background-color 0.5s"

    выбор состояние.выбранное-и-искомое-равно(число)
      либо да
        стиль.цвет-фона = "#070"
        стиль.анимация = "уменьшение-увеличение 0.2s"
      либо нет
        стиль.цвет-фона = "#700"
        стиль.анимация = "уменьшение-увеличение 0.2s"
      либо пусто
        стиль.цвет-фона = "#FFF2"
        стиль.анимация = ""
      кнц

    если состояние.искомое-находится-рядом-с(число)
      стиль.цвет = "#FFF"
    иначе
      стиль.цвет = "#555"
    кнц
  })
кнц
