тип Цветовая-Тема на-базе Р-Объект
  // Все свойства Р-Объекта являются сигналами
  перем время: Живое-Время
  перем тёмная: Да-Нет
  перем авто-режим: Да-Нет
  перем цвет-фона: Текст
  перем цвет-текста: Текст

  операция создание(живое-время: Живое-Время)
    время = живое-время
    тёмная = нет
    авто-режим = нет
    цвет-фона = ""
    цвет-текста = ""
  всё

  // #транзакция
  операция переключить()
    если не(авто-режим)
      тёмная = не(тёмная)
    всё
  всё

  // #транзакция
  операция переключить-авто-режим()
    авто-режим = не(авто-режим)
  всё

  // Скрыто

  // #реакция
  #скрыто-в-типе
  операция перенастройка()
    если авто-режим
      тёмная = время.час > 5 и время.час < 22
    всё
    если тёмная
      цвет-фона = "#091F27"
      цвет-текста = "#E0E0E0"
    иначе
      цвет-фона = "#FFFFFF"
      цвет-текста = "#000000"
    всё
  всё
всё
