тип Цветовая-Тема на-базе Р-Объект
  // Все свойства Р-Объекта являются сигналами
  перем время: Живое-Время
  перем тёмная: Да-Нет
  перем авто-режим: Да-Нет
  перем цвет-фона: Текст
  перем цвет-текста: Текст

  метод создание(живое-время: Живое-Время)
    время = живое-время
    тёмная = нет
    авто-режим = нет
    цвет-фона = ""
    цвет-текста = ""
  кон

  #транзакция
  метод переключить()
    если не(авто-режим)
      тёмная = не(тёмная)
    кон
  кон

  #транзакция
  метод переключить-авто-режим()
    авто-режим = не(авто-режим)
  кон

  // Скрыто

  #реакция
  #скрыто-в-типе
  метод перенастройка()
    если авто-режим
      тёмная = время.час < 5 или время.час > 22
    кон
    если тёмная
      цвет-фона = "#091F27"
      цвет-текста = "#E0E0E0"
    иначе
      цвет-фона = "#FFFFFF"
      цвет-текста = "#000000"
    кон
  кон
кон
