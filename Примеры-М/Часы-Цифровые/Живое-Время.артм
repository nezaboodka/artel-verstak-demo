  // Скрыто

  #транзакция
  операция такт()
    перем с = Дата-Время-Местное.сейчас()
    год = с.год
    месяц = с.месяц
    день = с.день
    час = с.час
    минута = с.минута
    секунда = с.секунда
    миллисекунда = с.миллисекунда
    // Взводим таймер на сам же метод "такт"
    перем калибровка: Целое = остаток(с.миллисекунда, экз.интервал)
    ЯС.отсрочить(такт, экз.интервал - калибровка)
  кнц
